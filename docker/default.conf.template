# Serves the page and forwards /api to the backend for frontend.
# ${BFF_URL} and ${NGINX_LOCAL_RESOLVERS} are filled at container start.

server {
  listen 8080;
  root /usr/share/nginx/html;

  # Resolve the backend at request time, so the page starts without it
  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

  location = /healthz {
    default_type text/plain;
    return 200 'ok';
  }

  location /api/ {
    set $bff ${BFF_URL};
    proxy_pass $bff;
  }

  location / {
    try_files $uri /index.html;
  }
}
